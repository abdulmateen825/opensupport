# Copy to .env.production. Replace all placeholders; do not commit the real file.
APP_ENV=production
APP_SECRET_KEY=
ENCRYPTION_KEY=
WIDGET_IDENTITY_SECRET=
CORS_ORIGINS=https://support.example.com
ACCESS_TOKEN_MINUTES=20
REFRESH_TOKEN_DAYS=14
IDENTITY_TOKEN_MINUTES=5
PUBLIC_RATE_LIMIT=90
AUTH_RATE_LIMIT=12
INGESTION_MAX_BYTES=10000000

# Must match DNS records pointing to this server. Caddy manages HTTPS.
API_DOMAIN=api.example.com
DASHBOARD_DOMAIN=support.example.com
ACME_EMAIL=admin@example.com
NEXT_PUBLIC_API_URL=https://api.example.com

# Use URL-safe passwords. Compose supplies internal service endpoints.
POSTGRES_PASSWORD=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=opensupport

# Select tested exact image versions or immutable digests before deployment.
# See the production guide for the official image sources.
QDRANT_IMAGE=
RUSTFS_IMAGE=

# Optional server-side AI and notifications
LLM_PROVIDER=openai-compatible
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=
RESEND_API_KEY=
ESCALATION_NOTIFICATION_EMAIL=
RESEND_FROM_EMAIL=OpenSupport <onboarding@resend.dev>
