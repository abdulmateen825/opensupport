{
  "name": "opensupport",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "corepack pnpm -r --if-present run build",
    "dev": "turbo run dev",
    "lint": "corepack pnpm -r --if-present run lint",
    "typecheck": "corepack pnpm -r --if-present run typecheck",
    "test:shopping": "corepack pnpm --filter @opensupport/widget test:shopping && corepack pnpm --filter @opensupport/demo-store test:shopping"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "16",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "8"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
