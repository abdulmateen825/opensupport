# Local service endpoints
DATABASE_URL=postgresql+asyncpg://opensupport:opensupport@localhost:5432/opensupport
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=opensupport
S3_SECRET_ACCESS_KEY=change-me
S3_BUCKET=opensupport

# API
APP_ENV=development
APP_SECRET_KEY=change-me
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Optional provider configuration (supply your own key)
LLM_PROVIDER=
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
EMBEDDING_MODEL=

# Optional escalation notification by Resend
RESEND_API_KEY=
ESCALATION_NOTIFICATION_EMAIL=
RESEND_FROM_EMAIL=OpenSupport <onboarding@resend.dev>
