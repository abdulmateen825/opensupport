# Local service endpoints
DATABASE_URL=postgresql+asyncpg://opensupport:opensupport@localhost:5432/opensupport
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=opensupport
S3_SECRET_ACCESS_KEY=change-me-now
S3_BUCKET=opensupport

# API
APP_ENV=development
APP_SECRET_KEY=change-me
WIDGET_IDENTITY_SECRET=change-me-with-a-separate-random-secret
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:5173
ENCRYPTION_KEY=change-me-with-a-random-32-byte-secret
PUBLIC_RATE_LIMIT=90
AUTH_RATE_LIMIT=12
ACCESS_TOKEN_MINUTES=20
REFRESH_TOKEN_DAYS=14
IDENTITY_TOKEN_MINUTES=5
INGESTION_MAX_BYTES=10000000

# Optional provider configuration (supply your own key)
LLM_PROVIDER=openai-compatible
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
EMBEDDING_MODEL=

# Optional escalation notification by Resend
RESEND_API_KEY=
ESCALATION_NOTIFICATION_EMAIL=
RESEND_FROM_EMAIL=OpenSupport <onboarding@resend.dev>

# Frontend values are public. Next.js reads apps/*/.env.local, not this root file.
# scripts/configure_env.py creates missing app files without overwriting values.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_OPENSUPPORT_PROJECT_ID=
OPENSUPPORT_API_URL=http://localhost:8000
